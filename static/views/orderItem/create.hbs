<h1>Добавить позицию в заказ</h1>
<form action="/order-items" method="POST">
  <input name="quantity" type="number" placeholder="Количество" required>
  <input name="productId" type="number" placeholder="ID товара" required>
  <input name="orderId" type="number" placeholder="ID заказа" required>
  <button type="submit">Сохранить</button>
</form>
<a href="/order-items">← Назад</a>